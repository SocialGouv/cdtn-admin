@tiptap-pro:registry=https://registry.tiptap.dev/
//registry.tiptap.dev/:_authToken=${NPM_TIPTAP_TOKEN}

# Hoist eslint binaries so they are accessible from workspace packages
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*

# Réseau résilient en CI : la dépendance xlsx est servie par cdn.sheetjs.com (hors registre npm),
# dont l'egress est instable depuis les runners PIC (ECONNRESET au handshake TLS). On augmente
# les retries/timeouts de fetch pour absorber ces coupures transitoires.
fetch-retries=6
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
