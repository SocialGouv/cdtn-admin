# Copy this file to `.env` and fill in the real values.

# Matomo PostgreSQL connection (read-only analytics — event data on the replica)
PG_MATOMO_USER=
PG_MATOMO_PASSWORD=
PG_MATOMO_HOST=
PG_MATOMO_DB=
PG_MATOMO_PORT=5432

# Matomo HTTP Reporting API (per-URL page views — used by reports/contrib_monthly_views.py)
# base URL = Matomo root, e.g. https://matomo.example.gouv.fr (no trailing /index.php)
MATOMO_BASE_URL=
MATOMO_SITE_ID=
# Optional: defaults to `anonymous` when left unset (works if the site allows
# anonymous reporting). Leave it COMMENTED — an empty `MATOMO_TOKEN_AUTH=` would
# override that default with an empty string. Uncomment only to use a real token.
# MATOMO_TOKEN_AUTH=

# Metabase PostgreSQL — DESTINATION written to by the ingest commands
# (ingest-simulateurs …). OPTIONAL locally: the defaults below already match the
# repo's `docker compose up -d metabase-db` (host port 5433). Set/override these
# only to target another database (e.g. a remote/staging Metabase).
METABASE_DB_HOST=localhost
METABASE_DB_PORT=5433
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=metabasepassword
METABASE_DB_NAME=metabase

# cdtn-search Elasticsearch — used only by the L2 pipeline's document-fetch
# stage (analysis.l2.build_docs).
ELASTICSEARCH_SEARCH_ENGINE_HOST=
ELASTICSEARCH_SEARCH_ENGINE_USER=
ELASTICSEARCH_SEARCH_ENGINE_PASSWORD=

# Albert (Etalab LLM API) — embeddings for analysis.l2.embed_questions, and
# for analysis.l2.embed_facets if you pass --provider albert there (OpenAI
# is the default for both build_docs and embed_facets). Get a key at
# https://albert.api.etalab.gouv.fr.
ALBERT_API_URL=https://albert.api.etalab.gouv.fr
ALBERT_API_KEY=
# ALBERT_EMBEDDINGS_MODEL=openweight-embeddings
# ALBERT_LLM_MODEL=openai/gpt-oss-120b

# Claude (Anthropic) API — used by analysis.l2.extract_facets (facet
# generation) and analysis.l2.describe_classes (raw HTTP, no `anthropic` SDK
# dependency). Get a key at https://console.anthropic.com -- create it under
# a SPECIFIC WORKSPACE (not "no workspace"/org-level), or you'll also need
# ANTHROPIC_WORKSPACE_ID below (400 invalid_request_error otherwise: "This
# API key is not scoped to a workspace...").
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# Only needed if ANTHROPIC_API_KEY is an org-level (not workspace-scoped) key.
# ANTHROPIC_WORKSPACE_ID=

# OpenAI API — embeddings only (analysis.connectors.openai, raw HTTP, no
# `openai` SDK dependency). Default embedding provider for analysis.l2.build_docs
# and analysis.l2.embed_facets. Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
