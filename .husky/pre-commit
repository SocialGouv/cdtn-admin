#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Strip Jupyter notebook outputs so none are committed (analysis playground, etc.).
# Le script relit lui-même l'index (NUL-delimited) : les chemins de notebooks
# contiennent des espaces, qu'un `xargs` découperait en faux fichiers.
staged_nb_count=$(git diff --cached --name-only --diff-filter=ACM | grep -c '\.ipynb"\?$' || true)
if [ "$staged_nb_count" -gt 0 ]; then
  command -v python3 >/dev/null 2>&1 || {
    echo "✗ python3 requis pour nettoyer les sorties des notebooks avant commit" >&2
    exit 1
  }
  python3 analysis/scripts/strip_nb_outputs.py --staged || exit 1
fi

pnpm run precommit;
